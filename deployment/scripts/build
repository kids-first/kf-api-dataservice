#!/bin/bash
set -e

function push_container() {
  echo "Push Container"
  set +e
  #stderr=$(docker push "${ACCOUNT_ID}".dkr.ecr."${REGION}".amazonaws.com/${PROJECT_NAME}:"${GIT_COMMIT}")
  docker push "${ACCOUNT_ID}".dkr.ecr."${REGION}".amazonaws.com/${PROJECT_NAME}:"${GIT_COMMIT}"
  set -e
}

#Attempt to set project name based on the git repo name
if [ -z $PROJECT_NAME ]; then
  PROJECT_NAME=$(basename -s .git $(git config --get remote.origin.url))
fi

if [ -z $REGION ]; then
  echo "Please provide REGION value (e.g. us-east-1)"
fi

REGION=${REGION}
ACCOUNT_ID=$(aws sts get-caller-identity --output text | awk '{print $1}')

if [[ -n "${GIT_COMMIT}" ]]; then
  GIT_COMMIT="${GIT_COMMIT:0:7}"
else
  GIT_COMMIT="$(git rev-parse --short HEAD)"
fi

aws ecr get-login-password --region "${REGION}" | docker login --username AWS --password-stdin "${ACCOUNT_ID}".dkr.ecr."${REGION}".amazonaws.com
docker build --platform linux/amd64 -t ${PROJECT_NAME} .
docker tag ${PROJECT_NAME}:latest "${ACCOUNT_ID}".dkr.ecr."${REGION}".amazonaws.com/${PROJECT_NAME}:"${GIT_COMMIT}"

push_container
